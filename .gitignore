# Recommended: keep .terraform.lock.hcl in Git.
# .terraform.lock.hcl

# Variable files containing secrets
*.auto.tfvars
*.auto.tfvars.json
terraform.tfvars
terraform.tfvars.json
*.secrets.tfvars
*.secrets.tfvars.json

# Backend configuration (optional if it contains secrets)
backend.tfvars

